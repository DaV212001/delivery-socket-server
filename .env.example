# ==============================================================================
# AMN Delivery Real-Time Socket Server Configuration
# ==============================================================================

# Server Network Settings (Render binds PORT automatically, default is 10000)
PORT=10000
HOST=0.0.0.0
NODE_ENV=development

# Allowed CORS Origins (comma-separated, or * for open during initial testing)
CORS_ORIGIN=*

# Core REST Backend API URL (Used to verify active orders, drivers, and customers)
# e.g., https://api.amnplc.com/api
BACKEND_API_BASE_URL=https://api.amnplc.com/api

# Internal API Secret Key or Bearer Token to authenticate server-to-server requests to Laravel backend
BACKEND_API_KEY=

# Validation Mode:
# 'strict'  -> Always requires live REST verification from backend API /my_order_detail/{id}
# 'fallback'-> Attempts backend REST API, but falls back to in-memory/mock cache if backend is unreachable or in dev mode
# 'mock'    -> For offline / isolated development & local unit testing
VALIDATION_MODE=fallback

# Order Cache TTL in seconds (to avoid redundant hits to the backend REST API on rapid reconnects)
ORDER_CACHE_TTL_SECONDS=30

# Maximum location history retained in memory per active order
MAX_LOCATION_HISTORY=100

# Ping interval & timeout for Socket.IO heartbeats (milliseconds)
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
